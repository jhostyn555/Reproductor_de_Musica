<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Panel Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin-panel.css" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#7c3aed" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="RolaLoka" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon-180.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/icons/favicon-32.png" />
</head>
<body class="admin-body">

    <!-- ══════════════════════════════════════════
         SIDEBAR
    ══════════════════════════════════════════ -->
    <aside class="admin-sidebar" id="adminSidebar">

        <!-- Sidebar Header -->
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <div class="brand-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 18V5l12-2v13"/>
                        <circle cx="6" cy="18" r="3"/>
                        <circle cx="18" cy="16" r="3"/>
                    </svg>
                </div>
                <div class="brand-text">
                    <span class="brand-name">MusicAdmin</span>
                    <span class="brand-sub">Panel de Control</span>
                </div>
            </div>
            <button class="sidebar-toggle-btn" id="sidebarToggle" title="Colapsar menú">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="12" x2="21" y2="12"/>
                    <line x1="3" y1="6"  x2="21" y2="6"/>
                    <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
            </button>
        </div>

        <!-- Admin profile pill -->
        <div class="sidebar-profile">
            <div class="profile-avatar">
                @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
            </div>
            <div class="profile-info">
                <span class="profile-name">@User.Identity?.Name</span>
                <span class="profile-role">Administrador</span>
            </div>
        </div>

        <!-- Botón volver al panel de usuario -->
        <div class="sidebar-back-btn-wrap">
            <a asp-controller="User" asp-action="Inicio" class="sidebar-back-btn" title="Volver al menú de clientes">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                <span class="sidebar-back-label">Menú de clientes</span>
            </a>
        </div>

        <!-- Navigation -->
        <nav class="sidebar-nav">
            <div class="nav-section-label">Principal</div>
            <ul class="sidebar-menu">

                <li class="menu-item @(ViewData["ActiveMenu"]?.ToString() == "Dashboard" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Dashboard" class="menu-link">
                        <span class="menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="7" height="7"/>
                                <rect x="14" y="3" width="7" height="7"/>
                                <rect x="14" y="14" width="7" height="7"/>
                                <rect x="3" y="14" width="7" height="7"/>
                            </svg>
                        </span>
                        <span class="menu-label">Dashboard</span>
                    </a>
                </li>

            </ul>

            <div class="nav-section-label">Contenido</div>
            <ul class="sidebar-menu">

                <li class="menu-item @(ViewData["ActiveMenu"]?.ToString() == "GenerosYArtistas" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="GenerosYArtistas" class="menu-link">
                        <span class="menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 18V5l12-2v13"/>
                                <circle cx="6" cy="18" r="3"/>
                                <circle cx="18" cy="16" r="3"/>
                            </svg>
                        </span>
                        <span class="menu-label">Géneros y Artistas</span>
                    </a>
                </li>

                <li class="menu-item @(ViewData["ActiveMenu"]?.ToString() == "Musicas" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Musicas" class="menu-link">
                        <span class="menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
                                <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
                            </svg>
                        </span>
                        <span class="menu-label">Músicas</span>
                    </a>
                </li>

                <li class="menu-item @(ViewData["ActiveMenu"]?.ToString() == "Albumes" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Albumes" class="menu-link">
                        <span class="menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </span>
                        <span class="menu-label">Álbumes</span>
                    </a>
                </li>

                <li class="menu-item @(ViewData["ActiveMenu"]?.ToString() == "Playlists" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Playlists" class="menu-link">
                        <span class="menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="8" y1="6" x2="21" y2="6"/>
                                <line x1="8" y1="12" x2="21" y2="12"/>
                                <line x1="8" y1="18" x2="21" y2="18"/>
                                <line x1="3" y1="6" x2="3.01" y2="6"/>
                                <line x1="3" y1="12" x2="3.01" y2="12"/>
                                <line x1="3" y1="18" x2="3.01" y2="18"/>
                            </svg>
                        </span>
                        <span class="menu-label">Playlists</span>
                    </a>
                </li>

            </ul>

            <div class="nav-section-label">Comunidad</div>
            <ul class="sidebar-menu">

                <li class="menu-item @(ViewData["ActiveMenu"]?.ToString() == "Comentarios" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Comentarios" class="menu-link">
                        <span class="menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                            </svg>
                        </span>
                        <span class="menu-label">Comentarios</span>
                    </a>
                </li>

                <li class="menu-item @(ViewData["ActiveMenu"]?.ToString() == "Usuarios" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Usuarios" class="menu-link">
                        <span class="menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                        </span>
                        <span class="menu-label">Usuarios</span>
                    </a>
                </li>

                <li class="menu-item @(ViewData["ActiveMenu"]?.ToString() == "Notificaciones" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Notificaciones" class="menu-link">
                        <span class="menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                            </svg>
                        </span>
                        <span class="menu-label">Notificaciones</span>
                    </a>
                </li>

            </ul>

            <div class="nav-section-label">Análisis</div>
            <ul class="sidebar-menu">

                <li class="menu-item @(ViewData["ActiveMenu"]?.ToString() == "Publicidad" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Publicidad" class="menu-link">
                        <span class="menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="7" width="20" height="15" rx="2" ry="2"/>
                                <polyline points="17 2 12 7 7 2"/>
                            </svg>
                        </span>
                        <span class="menu-label">Publicidad</span>
                    </a>
                </li>

            </ul>

            <div class="nav-section-label">Sesión</div>
            <ul class="sidebar-menu">

                <li class="menu-item">
                    <a asp-controller="User" asp-action="Inicio" class="menu-link">
                        <span class="menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="19" y1="12" x2="5" y2="12"/>
                                <polyline points="12 19 5 12 12 5"/>
                            </svg>
                        </span>
                        <span class="menu-label">Menú de clientes</span>
                    </a>
                </li>

                <li class="menu-item">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="menu-form">
                        <button type="submit" class="menu-link menu-link-logout">
                            <span class="menu-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                    <polyline points="16 17 21 12 16 7"/>
                                    <line x1="21" y1="12" x2="9" y2="12"/>
                                </svg>
                            </span>
                            <span class="menu-label">Cerrar sesión</span>
                        </button>
                    </form>
                </li>

            </ul>
        </nav>

        <!-- Sidebar Footer -->
        <div class="sidebar-footer">
            <a asp-controller="User" asp-action="Inicio" class="footer-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                <span>Menú de clientes</span>
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="footer-link footer-logout">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                    <span>Cerrar sesión</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- ══════════════════════════════════════════
         MAIN CONTENT AREA
    ══════════════════════════════════════════ -->
    <div class="admin-main" id="adminMain">

        <!-- Top bar -->
        <header class="admin-topbar">
            <div class="topbar-left">
                <button class="topbar-toggle" id="topbarToggle" title="Toggle sidebar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"/>
                        <line x1="3" y1="6"  x2="21" y2="6"/>
                        <line x1="3" y1="18" x2="21" y2="18"/>
                    </svg>
                </button>
                <nav aria-label="breadcrumb" class="admin-breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Admin</a></li>
                        <li class="breadcrumb-item active">@ViewData["Title"]</li>
                    </ol>
                </nav>
            </div>
            <div class="topbar-right">
                <div class="topbar-user">
                    <div class="topbar-avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                    </div>
                    <span class="topbar-name d-none d-sm-inline">@User.Identity?.Name</span>
                </div>
            </div>
        </header>

        <!-- Page content -->
        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <!-- Mobile overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            const sidebar  = document.getElementById('adminSidebar');
            const main     = document.getElementById('adminMain');
            const overlay  = document.getElementById('sidebarOverlay');
            const btnSide  = document.getElementById('sidebarToggle');
            const btnTop   = document.getElementById('topbarToggle');

            const COLLAPSED_KEY = 'adminSidebarCollapsed';

            // Restore state
            if (localStorage.getItem(COLLAPSED_KEY) === '1') {
                sidebar.classList.add('collapsed');
                main.classList.add('expanded');
            }

            function toggleSidebar() {
                const isCollapsed = sidebar.classList.toggle('collapsed');
                main.classList.toggle('expanded', isCollapsed);
                overlay.classList.toggle('active', !isCollapsed && window.innerWidth < 768);
                localStorage.setItem(COLLAPSED_KEY, isCollapsed ? '1' : '0');
            }

            function openMobile() {
                sidebar.classList.add('mobile-open');
                overlay.classList.add('active');
            }

            function closeMobile() {
                sidebar.classList.remove('mobile-open');
                overlay.classList.remove('active');
            }

            btnSide?.addEventListener('click', toggleSidebar);
            btnTop?.addEventListener('click', () => {
                if (window.innerWidth < 768) {
                    sidebar.classList.contains('mobile-open') ? closeMobile() : openMobile();
                } else {
                    toggleSidebar();
                }
            });

            overlay?.addEventListener('click', closeMobile);

            // Tooltip for collapsed state
            document.querySelectorAll('.menu-link').forEach(link => {
                link.addEventListener('mouseenter', () => {
                    if (sidebar.classList.contains('collapsed') && window.innerWidth >= 768) {
                        const label = link.querySelector('.menu-label')?.textContent;
                        link.setAttribute('title', label ?? '');
                    } else {
                        link.removeAttribute('title');
                    }
                });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/pwa.js" asp-append-version="true"></script>
</body>
</html>
