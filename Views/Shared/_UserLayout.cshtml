@inject EcommerceApp.Data.ApplicationDbContext Db
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — RolaLoka</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/user-panel.css" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#7c3aed" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="RolaLoka" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon-180.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/icons/favicon-32.png" />
    <style>
            /* Fondo: video en bucle con un velo oscuro para que el contenido se lea bien */
            body.user-panel-body {
                background: #000 !important;
            }

            .fondo-video {
                position: fixed;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                z-index: 0;
                pointer-events: none;
                background: #000;
            }

            .fondo-velo {
                position: fixed;
                inset: 0;
                z-index: 0;
                pointer-events: none;
                background: linear-gradient(180deg, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.55));
            }

            body.user-panel-body > .up-main {
                position: relative;
                z-index: 1;
                background: transparent;
            }

            /* Botón de cuenta: persona en reposo; imagen del perfil cuando el menú está abierto */
            .up-account-btn {
                position: relative;
            }

                .up-account-btn .up-acc-img {
                    display: none;
                    width: 26px;
                    height: 26px;
                    border-radius: 50%;
                    object-fit: cover;
                }

                .up-account-btn[aria-expanded="true"] .up-acc-img {
                    display: block;
                }

                .up-account-btn[aria-expanded="true"] .up-acc-icon {
                    display: none;
                }
    </style>
</head>
<body class="user-panel-body">
    <!-- Fondo: video en bucle (generado desde la imagen de referencia) -->
    <video class="fondo-video" autoplay muted loop playsinline preload="auto" aria-hidden="true" disablepictureinpicture>
        <source src="/video/fondo-neon.mp4" type="video/mp4" />
    </video>
    <div class="fondo-velo" aria-hidden="true"></div>
    <script>
            // Respeta la preferencia de "reducir movimiento": el video queda detenido en el primer cuadro.
            if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                document.querySelector('.fondo-video').pause();
            }
    </script>

    <!-- ══════════════════════════════════════════
         SIDEBAR
    ══════════════════════════════════════════ -->
    <aside class="up-sidebar" id="upSidebar">

        <!-- Brand -->
        <div class="up-sidebar-header">
            <div class="up-brand">
                <div class="up-brand-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 18V5l12-2v13" />
                        <circle cx="6" cy="18" r="3" />
                        <circle cx="18" cy="16" r="3" />
                    </svg>
                </div>
                <span class="up-brand-name">RolaLoka</span>
            </div>
            <button class="up-toggle-btn" id="upToggleBtn" title="Colapsar menú">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="18" x2="21" y2="18" />
                </svg>
            </button>
        </div>

        <!-- Navigation -->
        <nav class="up-nav">

            <ul class="up-menu">
                <li class="up-menu-item @(ViewData["ActiveMenu"]?.ToString() == "Inicio" ? "active" : "")">
                    <a asp-controller="User" asp-action="Inicio" class="up-menu-link">
                        <span class="up-menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                <polyline points="9 22 9 12 15 12 15 22" />
                            </svg>
                        </span>
                        <span class="up-menu-label">Inicio</span>
                    </a>
                </li>

                <li class="up-menu-item @(ViewData["ActiveMenu"]?.ToString() == "Musicas" ? "active" : "")">
                    <a asp-controller="User" asp-action="Musicas" class="up-menu-link">
                        <span class="up-menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 18V5l12-2v13" />
                                <circle cx="6" cy="18" r="3" />
                                <circle cx="18" cy="16" r="3" />
                            </svg>
                        </span>
                        <span class="up-menu-label">Músicas</span>
                    </a>
                </li>

                <li class="up-menu-item @(ViewData["ActiveMenu"]?.ToString() == "Historial" ? "active" : "")">
                    <a asp-controller="User" asp-action="Historial" class="up-menu-link">
                        <span class="up-menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="12 8 12 12 14 14" />
                                <path d="M3.05 11a9 9 0 1 1 .5 4m-.5 5v-5h5" />
                            </svg>
                        </span>
                        <span class="up-menu-label">Historial</span>
                    </a>
                </li>
                <li class="up-menu-item @(ViewData["ActiveMenu"]?.ToString() == "MisPlaylists" ? "active" : "")">
                    <a asp-controller="MisPlaylists" asp-action="Index" class="up-menu-link">
                        <span class="up-menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" /><line x1="3" y1="6" x2="3.01" y2="6" /><line x1="3" y1="12" x2="3.01" y2="12" /><line x1="3" y1="18" x2="3.01" y2="18" /></svg>
                        </span>
                        <span class="up-menu-label">Playlists</span>
                    </a>
                </li>

                <li class="up-menu-item @(ViewData["ActiveMenu"]?.ToString() == "Albumes" ? "active" : "")">
                    <a asp-controller="User" asp-action="Albumes" class="up-menu-link">
                        <span class="up-menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="3" /></svg>
                        </span>
                        <span class="up-menu-label">Álbumes</span>
                    </a>
                </li>
                <li class="up-menu-item @(ViewData["ActiveMenu"]?.ToString() == "Novedades" ? "active" : "")">
                    <a asp-controller="User" asp-action="Novedades" class="up-menu-link">
                        <span class="up-menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                            </svg>
                        </span>
                        <span class="up-menu-label">Novedades</span>
                    </a>
                </li>

                <li class="up-menu-item @(ViewData["ActiveMenu"]?.ToString() == "Perfil" ? "active" : "")">
                    <a asp-controller="User" asp-action="Perfil" class="up-menu-link">
                        <span class="up-menu-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                        </span>
                        <span class="up-menu-label">Perfil</span>
                    </a>
                </li>
            </ul>

            <!-- Divider -->
            <div class="up-nav-divider"></div>

            <!-- Acciones rápidas -->
            <ul class="up-menu">
                @if (User.IsInRole("Admin"))
                {
                    <li class="up-menu-item">
                        <a asp-controller="Admin" asp-action="Dashboard" class="up-menu-link up-link-admin">
                            <span class="up-menu-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                                </svg>
                            </span>
                            <span class="up-menu-label">Panel Admin</span>
                        </a>
                    </li>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="up-menu-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="up-logout-form">
                            <button type="submit" class="up-menu-link up-link-logout">
                                <span class="up-menu-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                        <polyline points="16 17 21 12 16 7" />
                                        <line x1="21" y1="12" x2="9" y2="12" />
                                    </svg>
                                </span>
                                <span class="up-menu-label">Cerrar sesión</span>
                            </button>
                        </form>
                    </li>
                }
            </ul>
        </nav>

        <!-- User profile footer -->
        @{
            var avatarFooter = User.Identity?.IsAuthenticated == true
                ? Db.Users.Where(u => u.UserName == User.Identity!.Name).Select(u => u.AvatarUrl).FirstOrDefault()
                : null;
        }
        <div class="up-sidebar-footer">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="up-user-avatar">
                    @if (!string.IsNullOrEmpty(avatarFooter))
                    {
                        <img src="@avatarFooter" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;display:block" />
                    }
                    else
                    {
                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                    }
                </div>
                <div class="up-user-info">
                    <span class="up-user-name">@User.Identity.Name</span>
                    <span class="up-user-role">@(User.IsInRole("Admin") ? "Administrador" : "Usuario")</span>
                </div>
            }
            else
            {
                <div class="up-user-avatar up-user-avatar-guest">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </div>
                <div class="up-user-info">
                    <span class="up-user-name">Invitado</span>
                    <a asp-controller="Account" asp-action="Login" class="up-user-role up-user-link">Iniciar sesión</a>
                </div>
            }
        </div>

    </aside>

    <!-- ══════════════════════════════════════════
         MAIN AREA
    ══════════════════════════════════════════ -->
    <div class="up-main" id="upMain">

        <!-- Topbar -->
        @{
            var avatarTop = User.Identity?.IsAuthenticated == true
                ? Db.Users.Where(u => u.UserName == User.Identity!.Name).Select(u => u.AvatarUrl).FirstOrDefault()
                : null;
        }
        @{
            var anunciosActivos = Db.Anuncios
                .Where(a => a.Activo && a.ImagenUrl != null)
                .OrderByDescending(a => a.CreadoEn)
                .ToList();
        }
        <header class="up-topbar">
            <div class="up-topbar-left">
                <button class="up-topbar-toggle" id="upTopToggle" title="Menú">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12" />
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <line x1="3" y1="18" x2="21" y2="18" />
                    </svg>
                </button>

                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb" class="up-breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a asp-controller="User" asp-action="Inicio">Mi Panel</a>
                        </li>
                        <li class="breadcrumb-item active">@ViewData["Title"]</li>
                    </ol>
                </nav>
            </div>

            <div class="up-topbar-right">
                <!-- Campana: muestra la publicidad activa en un panel emergente -->
                <div class="up-notif-btn" id="upNotifBtn" title="Publicidad" role="button" tabindex="0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                    </svg>
                    @if (anunciosActivos.Any())
                    {
                        <span class="up-notif-dot"></span>
                    }
                    <div class="up-notif-panel" id="up-notif-panel" hidden>
                        <div class="up-notif-head">Publicidad activa</div>
                        @if (!anunciosActivos.Any())
                        {
                            <div class="up-notif-vacio">No hay anuncios activos.</div>
                        }
                        @foreach (var an in anunciosActivos)
                        {
                            <button type="button" class="up-notif-item" data-zoom="@an.ImagenUrl" data-titulo="@an.Titulo" data-enlace="@(an.Enlace ?? "")">
                                <img src="@an.ImagenUrl" alt="" loading="lazy" />
                                <span>@an.Titulo</span>
                            </button>
                        }
                    </div>
                </div>

                <!-- Botón de cuenta (persona) -->
                <div class="dropdown">
                    <button class="up-account-btn" type="button" id="upAccountMenu" data-bs-toggle="dropdown" aria-expanded="false" title="Cuenta">
                        <svg class="up-acc-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                        @if (!string.IsNullOrEmpty(avatarTop))
                        {
                            <img class="up-acc-img" src="@avatarTop" alt="" />
                        }
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end up-account-menu" aria-labelledby="upAccountMenu">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li>
                                <div class="up-acc-head">
                                    <div class="up-acc-avatar">
                                        @if (!string.IsNullOrEmpty(avatarTop))
                                        {
                                            <img src="@avatarTop" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;display:block" />
                                        }
                                        else
                                        {
                                            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                        }
                                    </div>
                                    <div>
                                        <div class="up-acc-name">@User.Identity.Name</div>
                                        <div class="up-acc-role">@(User.IsInRole("Admin") ? "Administrador" : "Usuario")</div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit" class="dropdown-item">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Login">Iniciar sesión</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Register">Registrarse</a></li>
                        }
                    </ul>
                </div>
            </div>
        </header>

        <!-- Content -->
        <main class="up-content">
            @RenderBody()
        </main>
    </div>

    <!-- Mobile overlay -->
    <div class="up-overlay" id="upOverlay"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            (function () {
                const sidebar = document.getElementById('upSidebar');
                const main    = document.getElementById('upMain');
                const overlay = document.getElementById('upOverlay');
                const btnSide = document.getElementById('upToggleBtn');
                const btnTop  = document.getElementById('upTopToggle');
                const KEY     = 'upSidebarCollapsed';

                if (localStorage.getItem(KEY) === '1') {
                    sidebar.classList.add('collapsed');
                    main.classList.add('expanded');
                }

                function toggle() {
                    const col = sidebar.classList.toggle('collapsed');
                    main.classList.toggle('expanded', col);
                    localStorage.setItem(KEY, col ? '1' : '0');
                }

                function openMobile()  { sidebar.classList.add('mobile-open');    overlay.classList.add('active'); }
                function closeMobile() { sidebar.classList.remove('mobile-open'); overlay.classList.remove('active'); }

                btnSide?.addEventListener('click', toggle);
                btnTop?.addEventListener('click', () => {
                    if (window.innerWidth < 768) {
                        sidebar.classList.contains('mobile-open') ? closeMobile() : openMobile();
                    } else {
                        toggle();
                    }
                });

                overlay?.addEventListener('click', closeMobile);

                // Tooltip on collapsed
                document.querySelectorAll('.up-menu-link').forEach(link => {
                    link.addEventListener('mouseenter', () => {
                        if (sidebar.classList.contains('collapsed') && window.innerWidth >= 768) {
                            link.setAttribute('title', link.querySelector('.up-menu-label')?.textContent?.trim() ?? '');
                        } else {
                            link.removeAttribute('title');
                        }
                    });
                });
            })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    <script src="~/js/busqueda-voz.js" asp-append-version="true"></script>
    <script src="~/js/anuncios.js" asp-append-version="true"></script>
    <!-- Ventana flotante: agregar la canción a playlists -->
    @Html.AntiForgeryToken()
    <style>
            .pf-flotante {
                position: fixed;
                right: 16px;
                bottom: 170px;
                z-index: 9500;
                width: 300px;
                max-width: calc(100vw - 32px);
                background: #0f1222;
                border: 1px solid #232a44;
                border-radius: 14px;
                box-shadow: 0 18px 40px rgba(0,0,0,.55);
                overflow: hidden;
            }

                .pf-flotante[hidden] {
                    display: none !important;
                }

            .pf-head {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 10px 12px;
                cursor: pointer;
                background: linear-gradient(135deg, rgba(34,211,238,.18), rgba(167,139,250,.18));
                color: #e5e7eb;
                font-weight: 600;
                font-size: .9rem;
                user-select: none;
            }

                .pf-head .pf-titulo {
                    flex: 1;
                    min-width: 0;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                .pf-head .pf-cont {
                    font-size: .75rem;
                    color: #94a3b8;
                    font-weight: 500;
                }

                .pf-head button {
                    background: none;
                    border: none;
                    color: #e5e7eb;
                    cursor: pointer;
                    font-size: .95rem;
                    padding: 2px 6px;
                    border-radius: 6px;
                }

                    .pf-head button:hover {
                        background: rgba(255,255,255,.1);
                    }

            .pf-cuerpo {
                padding: 10px 12px 12px;
                display: grid;
                gap: 10px;
                max-height: 420px;
            }

                .pf-cuerpo[hidden] {
                    display: none !important;
                }

            .pf-lista {
                display: grid;
                gap: 6px;
                max-height: 220px;
                overflow-y: auto;
            }

            .pf-item {
                display: grid;
                grid-template-columns: auto 1fr;
                gap: 2px 10px;
                align-items: center;
                padding: 8px 10px;
                border-radius: 10px;
                background: rgba(255,255,255,.04);
                color: #e5e7eb;
                font-size: .88rem;
                cursor: pointer;
            }

                .pf-item input:disabled + span {
                    opacity: .55;
                }

                .pf-item small {
                    grid-column: 2;
                    color: #94a3b8;
                    font-size: .72rem;
                }

            .pf-vacio {
                color: #94a3b8;
                font-size: .85rem;
                text-align: center;
                margin: 6px 0;
            }

            .pf-nueva {
                display: flex;
                gap: 6px;
            }

                .pf-nueva input {
                    flex: 1;
                    min-width: 0;
                    padding: 8px 10px;
                    border-radius: 9px;
                    border: 1px solid #232a44;
                    background: transparent;
                    color: #e5e7eb;
                    font-size: .85rem;
                }

            .pf-btn {
                padding: 8px 12px;
                border-radius: 9px;
                border: none;
                font-weight: 600;
                font-size: .82rem;
                color: #04121a;
                background: linear-gradient(135deg,#22d3ee,#a78bfa);
                cursor: pointer;
                white-space: nowrap;
            }

            .pf-msg {
                font-size: .8rem;
                min-height: 1em;
            }

                .pf-msg.ok {
                    color: #4ade80;
                }

                .pf-msg.err {
                    color: #f87171;
                }

            .pf-toast {
                position: fixed;
                left: 50%;
                bottom: 96px;
                transform: translateX(-50%);
                z-index: 9900;
                background: #111827;
                color: #e5e7eb;
                padding: 10px 16px;
                border-radius: 12px;
                box-shadow: 0 10px 30px rgba(0,0,0,.5);
                font-size: .88rem;
                border: 1px solid #232a44;
            }
    </style>
    <div class="pf-flotante" id="pf-flotante" hidden>
        <div class="pf-head" id="pf-head" role="button" tabindex="0" aria-expanded="false">
            <span class="pf-titulo">Agregar a playlist</span>
            <span class="pf-cont" id="pf-cont"></span>
            <button type="button" id="pf-min" aria-label="Minimizar o expandir">▴</button>
            <button type="button" id="pf-cerrar" aria-label="Cerrar">✕</button>
        </div>
        <div class="pf-cuerpo" id="pf-cuerpo" hidden>
            <div class="pf-lista" id="pf-lista"></div>
            <div class="pf-nueva">
                <input id="pf-nueva-nombre" maxlength="120" placeholder="Nueva playlist..." autocomplete="off" />
                <button type="button" class="pf-btn" id="pf-crear">Crear</button>
            </div>
            <button type="button" class="pf-btn" id="pf-agregar">Agregar a las seleccionadas</button>
            <div class="pf-msg" id="pf-msg"></div>
        </div>
    </div>
    <script src="~/js/playlist-flotante.js" asp-append-version="true"></script>
</body>
</html>
