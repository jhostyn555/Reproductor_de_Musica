@model EcommerceApp.Models.MusicaBrowseViewModel
@using EcommerceApp.Models
@{
    var qs = string.IsNullOrEmpty(Model.Q) ? "" : "&q=" + Uri.EscapeDataString(Model.Q);
    var esGenero = Model.Vista == "genero";
    var hayCanciones = esGenero ? Model.Grupos.Any() : Model.Todas.Any();

    // Cola de reproducción: mismo orden en el que se muestran las canciones.
    var reproduccion = esGenero ? Model.Grupos.SelectMany(g => g.Canciones).ToList() : Model.Todas;
    var secuencia = reproduccion.Select(m => new
    {
        id = m.Id,
        nombre = m.Nombre,
        artista = string.Join(", ", m.MusicaArtistas.Select(ma => ma.Artista.Nombre)),
        artistaId = m.MusicaArtistas.Select(ma => (int?)ma.ArtistaId).FirstOrDefault(),
        artistaNombre = m.MusicaArtistas.Select(ma => ma.Artista.Nombre).FirstOrDefault() ?? "",
        audio = m.AudioUrl,
        imagen = m.ImagenUrl,
        meGusta = Model.FavoritosIds.Contains(m.Id)
    }).ToList();
}

<div class="mu-contenido">
    <form method="get" class="mu-search" role="search">
        <input type="hidden" name="vista" value="@Model.Vista" />
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
        <input type="search" name="q" value="@Model.Q" class="mu-search-input" placeholder="Buscar por canción, artista o género..." aria-label="Buscar" autocomplete="off" />
        @if (!string.IsNullOrEmpty(Model.Q))
        {
            <a class="mu-clear" href="?vista=@Model.Vista">Limpiar</a>
        }
        <button type="submit" class="mu-search-btn">Buscar</button>
    </form>

    @if (Model.Anuncios.Any())
    {
        <div class="mu-ads">
            @foreach (var an in Model.Anuncios)
            {
                <button type="button" class="mu-ad mu-ad-btn" data-zoom="@an.ImagenUrl" data-titulo="@an.Titulo" data-enlace="@(an.Enlace ?? "")">
                    <span class="mu-ad-tag">Anuncio</span>
                    <img src="@an.ImagenUrl" alt="@an.Titulo" loading="lazy" />
                    <div class="mu-ad-title">@an.Titulo</div>
                </button>
            }
        </div>
    }

    <div class="mu-switch">
        <a class="mu-vs @(esGenero ? "active" : "")" href="?vista=genero@(qs)">Por género</a>
        <a class="mu-vs @(!esGenero ? "active" : "")" href="?vista=cuadricula@(qs)">Cuadrícula</a>
    </div>

    <div class="mp-modo" role="group" aria-label="Vista del reproductor">
        <button type="button" class="mp-modo-btn" data-modo="miniatura">Vista miniatura</button>
        <button type="button" class="mp-modo-btn" data-modo="completa">Vista completa</button>
    </div>

    @if (!hayCanciones)
    {
        <div class="mu-empty">
            @if (string.IsNullOrEmpty(Model.Q))
            {
                <span>Todavía no hay canciones disponibles.</span>
            }
            else
            {
                <span>Sin resultados para «@Model.Q».</span>
            }
        </div>
    }
    else if (esGenero)
    {
        var pos = 0;
        foreach (var grupo in Model.Grupos)
        {
            var inicioGrupo = pos;
            <section class="mu-genero">
                <h2 class="mu-genero-titulo">
                    @grupo.Nombre
                    <span class="mu-count">@grupo.Canciones.Count @(grupo.Canciones.Count == 1 ? "canción" : "canciones")</span>
                </h2>
                <div class="mu-grid">
                    @foreach (var (m, i) in grupo.Canciones.Select((c, n) => (c, n)))
                    {
                        @await Html.PartialAsync("_TarjetaCancion", new CancionMenuVM
                        {
                            Musica = m,
                            EsFavorito = Model.FavoritosIds.Contains(m.Id),
                            PrimerArtistaId = m.MusicaArtistas.FirstOrDefault()?.ArtistaId,
                            PrimerAlbumId = m.AlbumMusicas.FirstOrDefault()?.AlbumId,
                            Pos = inicioGrupo + i
                        })
                    }
                </div>
            </section>
            pos += grupo.Canciones.Count;
        }
    }
    else
    {
        <div class="mu-grid mu-grid-compact">
            @foreach (var (m, i) in Model.Todas.Select((c, n) => (c, n)))
            {
                @await Html.PartialAsync("_TarjetaCancion", new CancionMenuVM
                {
                    Musica = m,
                    EsFavorito = Model.FavoritosIds.Contains(m.Id),
                    PrimerArtistaId = m.MusicaArtistas.FirstOrDefault()?.ArtistaId,
                    PrimerAlbumId = m.AlbumMusicas.FirstOrDefault()?.AlbumId,
                    Pos = i
                })
            }
        </div>
    }
</div>

@await Html.PartialAsync("_ReproductorMusicas", System.Text.Json.JsonSerializer.Serialize(secuencia))
