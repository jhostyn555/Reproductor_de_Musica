@model EcommerceApp.Models.MusicaBrowseViewModel
@{
    ViewData["Title"] = "Inicio";
    ViewData["ActiveMenu"] = "Inicio";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="up-page-heading">
    <h1>Inicio</h1>
    <p>Tu página de inicio</p>
</div>

@if (Model.Anuncios.Any())
{
    <div class="mu-ads">
        @foreach (var a in Model.Anuncios)
        {
            <div class="mu-ad">
                <span class="mu-ad-tag">Anuncio</span>
                @if (!string.IsNullOrEmpty(a.Enlace))
                {
                    <a href="@a.Enlace" target="_blank" rel="noopener noreferrer">
                        <img src="@a.ImagenUrl" alt="@a.Titulo" loading="lazy" />
                    </a>
                }
                else
                {
                    <img src="@a.ImagenUrl" alt="@a.Titulo" loading="lazy" />
                }
                <div class="mu-ad-title">@a.Titulo</div>
            </div>
        }
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="mu-ok">@TempData["Success"]</div>
}

@await Html.PartialAsync("_MusicaContenido", Model)

@section Scripts {
    <link rel="stylesheet" href="~/css/music-user.css" asp-append-version="true" />
    <script src="~/js/cancion-menu.js" asp-append-version="true"></script>
}
