@model EcommerceApp.Models.PerfilViewModel
@{
    ViewData["Title"] = "Perfil";
    ViewData["ActiveMenu"] = "Perfil";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="up-page-heading">
    <h1>Perfil</h1>
    <p>Tu información y configuración</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="pf-ok">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="pf-err">@TempData["Error"]</div>
}

<div class="pf-grid">
    <section class="pf-card">
        <div class="pf-avatar">
            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
            {
                <img src="@Model.AvatarUrl" alt="Avatar" />
            }
            else
            {
                <span>@(Model.UserName.Length > 0 ? Model.UserName.Substring(0, 1).ToUpper() : "U")</span>
            }
        </div>
        <form asp-action="PerfilAvatar" method="post" enctype="multipart/form-data" class="pf-form">
            <label>Cambiar imagen de perfil</label>
            <input type="file" name="archivo" accept="image/*" class="pf-input" required />
            <button type="submit" class="pf-btn">Subir avatar</button>
        </form>
    </section>

    <section class="pf-card">
        <form asp-action="PerfilNombre" method="post" class="pf-form">
            <label asp-for="UserName">Nombre de usuario</label>
            <input asp-for="UserName" class="pf-input" maxlength="30" />
            <span class="pf-hint">Entre 3 y 30 caracteres. Tu correo no cambia.</span>
            <button type="submit" class="pf-btn">Guardar nombre</button>
        </form>
        <div class="pf-dato">
            <span>Correo</span>
            <b>@Model.Email</b>
        </div>
    </section>

    <section class="pf-card">
        <h3 class="pf-titulo">Mis canciones</h3>
        <p class="pf-hint">Envía una canción. El administrador la aprobará antes de hacerla pública.</p>
        <a asp-action="CrearCancion" class="pf-btn" style="text-align:center;text-decoration:none">+ Crear canción</a>
    </section>

    <section class="pf-card">
        <h3 class="pf-titulo">Sesión</h3>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="pf-btn pf-btn-danger">Cerrar sesión</button>
        </form>
    </section>
</div>

<style>
    .pf-grid {
        display: grid;
        gap: 18px;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    }

    .pf-card {
        background: var(--up-sidebar-bg, #0f1222);
        border: 1px solid var(--up-border, #232a44);
        border-radius: 14px;
        padding: 20px;
        display: grid;
        gap: 14px;
        align-content: start;
    }

    .pf-titulo {
        margin: 0;
        font-size: 1rem;
        color: var(--up-txt);
    }

    .pf-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.6rem;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, var(--up-primary, #22d3ee), var(--up-accent, #a78bfa));
    }

        .pf-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .pf-form {
        display: grid;
        gap: 8px;
    }

        .pf-form label {
            font-size: .82rem;
            color: var(--up-txt-sub);
        }

    .pf-input {
        padding: 10px 12px;
        border-radius: 9px;
        background: transparent;
        border: 1px solid var(--up-border, #232a44);
        color: var(--up-txt);
    }

    .pf-hint {
        font-size: .75rem;
        color: var(--up-txt-muted);
    }

    .pf-btn {
        padding: 10px 16px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        font-weight: 600;
        font-size: .88rem;
        color: #04121a;
        background: linear-gradient(135deg, var(--up-primary, #22d3ee), var(--up-accent, #a78bfa));
    }

    .pf-btn-danger {
        background: rgba(248,113,113,.15);
        color: #f87171;
        border: 1px solid rgba(248,113,113,.4);
        width: 100%;
    }

    .pf-dato {
        display: grid;
        gap: 2px;
        font-size: .9rem;
    }

        .pf-dato span {
            font-size: .72rem;
            color: var(--up-txt-muted);
            text-transform: uppercase;
            letter-spacing: .06em;
        }

        .pf-dato b {
            color: var(--up-txt);
            font-weight: 600;
            word-break: break-all;
        }

    .pf-ok {
        padding: 12px 16px;
        border-radius: 10px;
        margin-bottom: 18px;
        background: rgba(34,197,94,.1);
        color: #4ade80;
        border: 1px solid rgba(34,197,94,.3);
    }

    .pf-err {
        padding: 12px 16px;
        border-radius: 10px;
        margin-bottom: 18px;
        background: rgba(248,113,113,.1);
        color: #f87171;
        border: 1px solid rgba(248,113,113,.3);
    }
    
    .pf-grid,
    .pf-card,
    .pf-form {
        min-width: 0;
        box-sizing: border-box;
    }

    .pf-card {
        width: 100%;
    }

    .pf-input {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
    }

    .pf-form input[type="file"] {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
        font-size: 0.85rem;
    }

    .pf-btn {
        width: 100%;
        box-sizing: border-box;
        overflow-wrap: anywhere;
    }

    .pf-dato b {
        overflow-wrap: anywhere;
    }

    @@media (max-width: 600px) {
        .pf-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 14px;
        }

        .pf-card {
            padding: 16px;
        }

        .pf-avatar {
            width: 100px;
            height: 100px;
        }

        .pf-form input[type="file"] {
            font-size: 0.75rem;
        }
    }
</style>
