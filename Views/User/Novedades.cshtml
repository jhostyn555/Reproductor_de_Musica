@model EcommerceApp.Models.NovedadesViewModel
@{
    ViewData["Title"] = "Novedades";
    ViewData["ActiveMenu"] = "Novedades";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="up-page-heading">
    <h1>Novedades</h1>
    <p>Lo que se publicó hoy</p>
</div>

<section class="nv-seccion">
    <h2>Canciones de hoy</h2>
    @if (!Model.Canciones.Any())
    {
        <div class="nv-vacio">Hoy no se agregaron canciones.</div>
    }
    else
    {
        <div class="nv-grid">
            @foreach (var m in Model.Canciones)
            {
                var artistas = string.Join(", ", m.MusicaArtistas.Select(ma => ma.Artista.Nombre));
                <a class="nv-card" asp-controller="User" asp-action="Escuchar" asp-route-id="@m.Id">
                    <div class="nv-cover">
                        @if (!string.IsNullOrEmpty(m.ImagenUrl))
                        {
                            <img src="@m.ImagenUrl" alt="@m.Nombre" loading="lazy" />
                        }
                        else
                        {
                            <span>♪</span>
                        }
                    </div>
                    <div class="nv-name">@m.Nombre</div>
                    @if (!string.IsNullOrEmpty(artistas))
                    {
                        <div class="nv-sub">@artistas</div>
                    }
                </a>
            }
        </div>
    }
</section>

<section class="nv-seccion">
    <h2>Publicidad de hoy</h2>
    @if (!Model.Anuncios.Any())
    {
        <div class="nv-vacio">Hoy no se publicaron anuncios.</div>
    }
    else
    {
        <div class="nv-ads">
            @foreach (var a in Model.Anuncios)
            {
                <div class="nv-ad">
                    @if (!string.IsNullOrEmpty(a.Enlace))
                    {
                        <a href="@a.Enlace" target="_blank" rel="noopener noreferrer">
                            <img src="@a.ImagenUrl" alt="@a.Titulo" loading="lazy" />
                        </a>
                    }
                    else
                    {
                        <img src="@a.ImagenUrl" alt="@a.Titulo" loading="lazy" />
                    }
                    <div class="nv-ad-title">@a.Titulo</div>
                </div>
            }
        </div>
    }
</section>

<style>
    .nv-seccion { margin-bottom: 36px; }
    .nv-seccion h2 { font-size: 1.2rem; font-weight: 700; color: var(--up-txt); margin: 0 0 14px; padding-bottom: 8px; border-bottom: 1px solid var(--up-border); }
    .nv-vacio { padding: 24px; text-align: center; color: var(--up-txt-muted); border: 1px dashed var(--up-border); border-radius: 12px; }
    .nv-grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); }
    .nv-card { text-decoration: none; color: inherit; min-width: 0; }
    .nv-cover { aspect-ratio: 1 / 1; border-radius: 12px; overflow: hidden; background: rgba(255,255,255,.04); display: flex; align-items: center; justify-content: center; color: var(--up-txt-muted); font-size: 2rem; margin-bottom: 10px; }
    .nv-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .nv-name { font-weight: 600; font-size: .92rem; color: var(--up-txt); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .nv-sub { font-size: .8rem; color: var(--up-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .nv-ads { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
    .nv-ad { border-radius: 14px; overflow: hidden; border: 1px solid var(--up-border); background: var(--up-sidebar-bg); }
    .nv-ad img { width: 100%; height: 150px; object-fit: cover; display: block; }
    .nv-ad-title { padding: 10px 12px; font-weight: 600; font-size: .88rem; color: var(--up-txt); }
</style>
