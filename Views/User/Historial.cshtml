@{
    ViewData["Title"]      = "Historial";
    ViewData["ActiveMenu"] = "Historial";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    var icon = @"<svg xmlns='http://www.w3.org/2000/svg' width='38' height='38' viewBox='0 0 24 24'
         fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
        <polyline points='12 8 12 12 14 14'/>
        <path d='M3.05 11a9 9 0 1 1 .5 4m-.5 5v-5h5'/>
    </svg>";
}

<div class="up-page-heading">
    <h1>Historial</h1>
    <p>Tu actividad y canciones reproducidas</p>
</div>

<div class="up-construction">
    <div class="up-uc-icon">@Html.Raw(icon)</div>
    <h2 class="up-uc-title">Panel en construcción</h2>
    <p class="up-uc-text">La sección de <strong>Historial</strong> está siendo desarrollada.<br>Pronto verás aquí todo lo que has escuchado.</p>
    <div class="up-uc-badge">
        <div class="up-uc-dots">
            <div class="up-uc-dot"></div>
            <div class="up-uc-dot"></div>
            <div class="up-uc-dot"></div>
        </div>
        En desarrollo
    </div>
</div>
