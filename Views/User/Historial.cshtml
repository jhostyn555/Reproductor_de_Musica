@model IEnumerable<EcommerceApp.Models.HistorialItem>
@{
    ViewData["Title"] = "Historial";
    ViewData["ActiveMenu"] = "Historial";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="up-page-heading">
    <h1>Historial</h1>
    <p>Canciones que has escuchado</p>
</div>

@if (!Model.Any())
{
    <div class="hi-empty">Todavía no has escuchado canciones. Cuando reproduzcas una, aparecerá aquí.</div>
}
else
{
    <ol class="hi-lista">
        @foreach (var item in Model)
        {
            var artistas = string.Join(", ", item.Musica.MusicaArtistas.Select(ma => ma.Artista.Nombre));
            <li class="hi-item">
                <a class="hi-cover" asp-controller="User" asp-action="Escuchar" asp-route-id="@item.Musica.Id" aria-label="Escuchar @item.Musica.Nombre">
                    @if (!string.IsNullOrEmpty(item.Musica.ImagenUrl))
                    {
                        <img src="@item.Musica.ImagenUrl" alt="" loading="lazy" />
                    }
                    else
                    {
                        <span>♪</span>
                    }
                </a>
                <div class="hi-text">
                    <a class="hi-name" asp-controller="User" asp-action="Escuchar" asp-route-id="@item.Musica.Id">@item.Musica.Nombre</a>
                    @if (!string.IsNullOrEmpty(artistas))
                    {
                        <div class="hi-artist">@artistas</div>
                    }
                </div>
                <div class="hi-meta">
                    <span>@item.Reproducciones @(item.Reproducciones == 1 ? "reproducción" : "reproducciones")</span>
                    <span>@item.Ultima.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </li>
        }
    </ol>
}

<style>
    .hi-empty { padding: 40px; text-align: center; color: var(--up-txt-sub); border: 1px dashed var(--up-border); border-radius: var(--radius); }
    .hi-lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
    .hi-item { display: grid; grid-template-columns: 52px 1fr auto; gap: 14px; align-items: center; padding: 8px 10px; border-radius: 10px; }
    .hi-item:hover { background: rgba(255,255,255,.04); }
    .hi-cover { width: 52px; height: 52px; border-radius: 8px; overflow: hidden; background: rgba(255,255,255,.06); display: flex; align-items: center; justify-content: center; color: var(--up-txt-muted); }
    .hi-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .hi-text { min-width: 0; }
    .hi-name { display: block; font-weight: 600; color: var(--up-txt); text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .hi-name:hover { color: var(--up-primary); }
    .hi-artist { font-size: .8rem; color: var(--up-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .hi-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; font-size: .75rem; color: var(--up-txt-muted); white-space: nowrap; }
    @@media (max-width: 560px) { .hi-meta { display: none; } }
</style>
