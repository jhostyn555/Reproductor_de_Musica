@model EcommerceApp.Models.MusicaBrowseViewModel
@{
    ViewData["Title"] = "Músicas";
    ViewData["ActiveMenu"] = "Musicas";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="up-page-heading">
    <h1>Músicas</h1>
    <p>Explora la música por género</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="mu-ok">@TempData["Success"]</div>
}

@await Html.PartialAsync("_MusicaContenido", Model)

@section Scripts {
    <link rel="stylesheet" href="~/css/music-user.css" asp-append-version="true" />
    <script src="~/js/cancion-menu.js" asp-append-version="true"></script>
}
