@model EcommerceApp.Models.CancionMenuVM

@{
    var m = Model.Musica;
    var artistas = string.Join(", ", m.MusicaArtistas.Select(ma => ma.Artista.Nombre));
}

<article class="mu-card">
    @if (Model.Pos.HasValue)
    {
        <button type="button"
                class="mu-cover-link mu-cover-btn"
                data-play="@Model.Pos.Value"
                aria-label="Reproducir @m.Nombre">
            <div class="mu-cover">
                @if (!string.IsNullOrEmpty(m.ImagenUrl))
                {
                    <img src="@m.ImagenUrl" alt="@m.Nombre" loading="lazy" />
                }
                else
                {
                    <div class="mu-placeholder">♪</div>
                }
                <span class="mu-play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span>
            </div>
        </button>
    }
    else
    {
        <a class="mu-cover-link"
           asp-controller="User"
           asp-action="Escuchar"
           asp-route-id="@m.Id"
           aria-label="Escuchar @m.Nombre">
            <div class="mu-cover">
                @if (!string.IsNullOrEmpty(m.ImagenUrl))
                {
                    <img src="@m.ImagenUrl" alt="@m.Nombre" loading="lazy" />
                }
                else
                {
                    <div class="mu-placeholder">♪</div>
                }
                <span class="mu-play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span>
            </div>
        </a>
    }

    <div class="mu-meta">
        <div class="mu-text">
            <a class="mu-name"
               asp-controller="User"
               asp-action="Escuchar"
               asp-route-id="@m.Id"
               title="@m.Nombre">@m.Nombre</a>
            @if (!string.IsNullOrEmpty(artistas))
            {
                <div class="mu-artists">@artistas</div>
            }
        </div>

        @await Html.PartialAsync("_CancionMenu", Model)
    </div>
</article>