@model IEnumerable<EcommerceApp.Models.Album>
@{
    ViewData["Title"] = "Álbumes";
    ViewData["ActiveMenu"] = "Albumes";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="up-page-heading">
    <h1>Álbumes</h1>
    <p>Los álbumes publicados en RolaLoka</p>
</div>

<style>
    .cal-grid { display: grid; gap: 22px; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
    .cal-card { text-decoration: none; color: inherit; min-width: 0; display: block; }
    .cal-cover { aspect-ratio: 1 / 1; border-radius: 12px; overflow: hidden; background: rgba(255,255,255,.04); margin-bottom: 10px; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; color: var(--up-txt-muted); }
    .cal-cover img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
    .cal-card:hover img { transform: scale(1.04); }
    .cal-t { font-weight: 700; color: var(--up-txt); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cal-a { font-size: .85rem; color: var(--up-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cal-m { font-size: .75rem; color: var(--up-txt-muted); }
    .cal-vacio { padding: 40px; text-align: center; color: var(--up-txt-sub); border: 1px dashed var(--up-border); border-radius: 12px; }
</style>

@if (!Model.Any())
{
    <div class="cal-vacio">Todavía no hay álbumes publicados.</div>
}
else
{
    <div class="cal-grid">
        @foreach (var a in Model)
        {
            <a class="cal-card" asp-controller="User" asp-action="Album" asp-route-id="@a.Id">
                <div class="cal-cover">
                    @if (!string.IsNullOrEmpty(a.ImagenUrl))
                    {
                        <img src="@a.ImagenUrl" alt="@a.Titulo" loading="lazy" />
                    }
                    else
                    {
                        <span>♪</span>
                    }
                </div>
                <div class="cal-t">@a.Titulo</div>
                <div class="cal-a">@a.Artista.Nombre</div>
                <div class="cal-m">@a.CantidadCanciones @(a.CantidadCanciones == 1 ? "canción" : "canciones") · @a.FechaCreacion.ToString("yyyy")</div>
            </a>
        }
    </div>
}
