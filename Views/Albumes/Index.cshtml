@model IEnumerable<EcommerceApp.Models.Album>
@using EcommerceApp.Models
@{
    ViewData["Title"] = "Álbumes";
    ViewData["ActiveMenu"] = "Albumes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var busqueda = ViewData["Q"]?.ToString() ?? string.Empty;
    var total = Convert.ToInt32(ViewData["Total"] ?? Model.Count());
    var hayFiltro = !string.IsNullOrEmpty(busqueda);
}

<div class="page-heading d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div>
        <h1>Álbumes</h1>
        @if (hayFiltro)
        {
            <p>Resultados para «@busqueda» — @Model.Count() de @total registros</p>
        }
        else
        {
            <p>@Model.Count() registros</p>
        }
    </div>
    <a asp-action="Create" class="al-btn">+ Nuevo álbum</a>
</div>

<form method="get" class="al-search" role="search">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="search" name="q" value="@busqueda" autocomplete="off" class="al-search-input"
           placeholder="Buscar por título o artista..." aria-label="Buscar álbumes" />
    @if (hayFiltro)
    {
        <a asp-action="Index" class="al-clear">Limpiar</a>
    }
    <button type="submit" class="al-search-btn">Buscar</button>
</form>

@if (TempData["Success"] != null) { <div class="al-ok">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="al-err">@TempData["Error"]</div> }

@if (!Model.Any())
{
    <div class="al-empty">
        @if (hayFiltro)
        {
            <span>Sin resultados para «@busqueda».</span>
        }
        else
        {
            <span>Todavía no hay álbumes. Crea el primero con el botón de arriba.</span>
        }
    </div>
}
else
{
    <div class="al-grid">
        @foreach (var a in Model)
        {
            <article class="al-card">
                <a class="al-cover" asp-action="Escuchar" asp-route-id="@a.Id" title="Escuchar las canciones de @a.Titulo">
                    @if (!string.IsNullOrEmpty(a.ImagenUrl))
                    {
                        <img src="@a.ImagenUrl" alt="@a.Titulo" loading="lazy" />
                    }
                    else
                    {
                        <div class="al-placeholder">♪</div>
                    }
                    <span class="al-tipo">@a.Tipo</span>
                </a>

                <div class="al-info">
                    <div class="al-title" title="@a.Titulo">@a.Titulo</div>
                    <div class="al-artist">@a.Artista.Nombre</div>
                    <div class="al-meta">
                        <span>@a.CantidadCanciones @(a.CantidadCanciones == 1 ? "canción" : "canciones")</span>
                        <span>@DuracionFormato.Total(a.DuracionTotalSegundos)</span>
                        <span>@a.FechaCreacion.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>

                <div class="al-actions">
                    <a asp-action="Edit" asp-route-id="@a.Id" class="al-act" title="Editar">Editar</a>
                    <form asp-action="Delete" asp-route-id="@a.Id" method="post" onsubmit="return confirm('¿Eliminar este álbum?')">
                        <button type="submit" class="al-act del">Eliminar</button>
                    </form>
                </div>
            </article>
        }
    </div>
}

<style>
    .al-btn { padding: 10px 18px; border-radius: 10px; font-weight: 600; font-size: .88rem; color: #fff; text-decoration: none; background: linear-gradient(135deg, var(--clr-primary, #7c5cff), var(--clr-primary-2, #a78bfa)); }
    .al-search { display: flex; align-items: center; gap: 10px; margin: 22px 0; background: var(--bg-card); border: 1px solid var(--border-col); border-radius: 12px; padding: 6px 6px 6px 14px; }
    .al-search:focus-within { border-color: var(--clr-primary, #7c5cff); }
    .al-search svg { color: var(--txt-muted); flex-shrink: 0; }
    .al-search-input { flex: 1; min-width: 0; background: transparent; border: none; outline: none; color: var(--txt-primary); font-size: .9rem; padding: 8px 0; }
    .al-search-input::placeholder { color: var(--txt-muted); }
    .al-clear { font-size: .8rem; color: var(--txt-secondary); padding: 6px 10px; text-decoration: none; white-space: nowrap; }
    .al-search-btn { padding: 9px 16px; border-radius: 9px; font-size: .82rem; font-weight: 600; color: #fff; border: none; cursor: pointer; background: linear-gradient(135deg, var(--clr-primary, #7c5cff), var(--clr-primary-2, #a78bfa)); }
    .al-ok { padding: 12px 16px; border-radius: 10px; margin-bottom: 18px; background: rgba(34,197,94,.1); color: #4ade80; border: 1px solid rgba(34,197,94,.3); }
    .al-err { padding: 12px 16px; border-radius: 10px; margin-bottom: 18px; background: rgba(248,113,113,.1); color: #f87171; border: 1px solid rgba(248,113,113,.3); }
    .al-empty { padding: 40px; text-align: center; color: var(--txt-muted); border: 1px dashed var(--border-col); border-radius: 12px; }
    .al-grid { display: grid; gap: 24px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
    .al-card { background: transparent; border: none; padding: 0; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
    .al-cover { position: relative; display: block; aspect-ratio: 1 / 1; width: 100%; border-radius: 12px; overflow: hidden; background: rgba(255,255,255,.04); cursor: pointer; }
    .al-cover img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
    .al-cover:hover img { transform: scale(1.04); }
    .al-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; color: var(--txt-muted); }
    .al-tipo { position: absolute; top: 8px; left: 8px; font-size: .68rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 3px 8px; border-radius: 6px; background: rgba(0,0,0,.65); color: #fff; }
    .al-info { padding: 0 2px; min-width: 0; }
    .al-title { font-weight: 700; color: var(--txt-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .al-artist { font-size: .85rem; color: #22d3ee; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .al-meta { display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: .74rem; color: var(--txt-muted); margin-top: 4px; }
    .al-actions { display: flex; gap: 8px; padding: 0 2px; }
    .al-actions form { margin: 0; }
    .al-act { padding: 6px 12px; border-radius: 8px; font-size: .8rem; color: var(--txt-secondary); text-decoration: none; background: transparent; border: 1px solid var(--border-col); cursor: pointer; }
    .al-act:hover { color: var(--txt-primary); background: rgba(255,255,255,.05); }
    .al-act.del:hover { color: #f87171; border-color: rgba(248,113,113,.4); }
</style>
