@model IEnumerable<EcommerceApp.Models.Musica>
@{
    ViewData["Title"]      = "Músicas";
    ViewData["ActiveMenu"] = "Musicas";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-heading d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div>
        <h1>Músicas</h1>
        <p>Catálogo de canciones — @Model.Count() registros</p>
    </div>
    <a asp-controller="Musicas" asp-action="Create" class="btn-primary-action">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nueva Canción
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-custom alert-success-custom">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-custom alert-error-custom">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        @TempData["Error"]
    </div>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
        </div>
        <p class="empty-title">No hay canciones aún</p>
        <p class="empty-sub">Crea tu primera canción usando el botón de arriba.</p>
    </div>
}
else
{
    <div class="music-grid">
        @foreach (var m in Model)
        {
            <div class="music-card">
                <div class="music-cover">
                    @if (!string.IsNullOrEmpty(m.ImagenUrl))
                    {
                        <img src="@m.ImagenUrl" alt="@m.Nombre" loading="lazy" />
                    }
                    else
                    {
                        <div class="music-cover-placeholder">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
                        </div>
                    }
                </div>
                <div class="music-info">
                    <div class="music-name">@m.Nombre</div>

                    @if (m.MusicaArtistas.Any())
                    {
                        <div class="music-artists">
                            @string.Join(", ", m.MusicaArtistas.Select(ma => ma.Artista.Nombre))
                        </div>
                    }

                    @if (m.MusicaGeneros.Any())
                    {
                        <div class="music-genres">
                            @foreach (var mg in m.MusicaGeneros)
                            {
                                <span class="genre-badge">@mg.Genero.Nombre</span>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(m.AudioUrl))
                    {
                        <audio controls class="music-audio-player" preload="none">
                            <source src="@m.AudioUrl" type="audio/mpeg" />
                            Tu navegador no soporta audio.
                        </audio>
                    }

                    <div class="music-meta">
                        <span class="music-date">@m.CreadoEn.ToLocalTime().ToString("dd MMM yyyy")</span>
                    </div>
                </div>
                <div class="music-actions">
                    <a asp-controller="Musicas" asp-action="Edit" asp-route-id="@m.Id" class="action-btn edit-btn" title="Editar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    </a>
                    <form asp-controller="Musicas" asp-action="Delete" asp-route-id="@m.Id" method="post"
                          onsubmit="return confirm('¿Eliminar «@m.Nombre»? Esta acción también eliminará los archivos de Cloudinary.')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="action-btn delete-btn" title="Eliminar">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
<style>
/* ── Musicas Index ── */
.btn-primary-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: linear-gradient(135deg, var(--clr-primary), var(--clr-primary-2));
    color: #fff;
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: opacity .2s, transform .2s;
    text-decoration: none;
    box-shadow: 0 4px 16px var(--clr-primary-glow);
}
.btn-primary-action:hover { opacity: .88; transform: translateY(-1px); color: #fff; }

.alert-custom {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 18px; border-radius: 10px; margin-bottom: 20px;
    font-size: .875rem; font-weight: 500;
}
.alert-success-custom { background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.3); color: #4ade80; }
.alert-error-custom   { background: rgba(239,68,68,.1);  border: 1px solid rgba(239,68,68,.3);  color: #f87171; }

.empty-state {
    display: flex; flex-direction: column; align-items: center;
    padding: 80px 40px; background: var(--bg-card);
    border: 1px solid var(--border-col); border-radius: 20px;
    text-align: center;
}
.empty-icon {
    width: 80px; height: 80px; border-radius: 50%;
    background: linear-gradient(135deg, rgba(139,92,246,.2), rgba(99,102,241,.15));
    border: 2px solid rgba(139,92,246,.3);
    display: flex; align-items: center; justify-content: center;
    color: var(--clr-primary); margin-bottom: 20px;
}
.empty-title { font-size: 1.1rem; font-weight: 700; color: var(--txt-primary); margin-bottom: 6px; }
.empty-sub   { font-size: .875rem; color: var(--txt-secondary); }

.music-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 18px;
}
.music-card {
    background: var(--bg-card);
    border: 1px solid var(--border-col);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition), box-shadow var(--transition);
}
.music-card:hover {
    border-color: var(--clr-primary);
    box-shadow: var(--shadow-card);
}
.music-cover {
    width: 100%; aspect-ratio: 1;
    background: rgba(139,92,246,.08);
    overflow: hidden;
    max-height: 180px;
}
.music-cover img { width: 100%; height: 100%; object-fit: cover; }
.music-cover-placeholder {
    width: 100%; height: 180px;
    display: flex; align-items: center; justify-content: center;
    color: var(--txt-muted);
}
.music-info { padding: 14px 16px; flex: 1; display: flex; flex-direction: column; gap: 8px; }
.music-name { font-size: .95rem; font-weight: 700; color: var(--txt-primary); line-height: 1.3; }
.music-artists { font-size: .8rem; color: var(--clr-accent); font-weight: 500; }
.music-genres { display: flex; flex-wrap: wrap; gap: 5px; }
.genre-badge {
    font-size: .7rem; font-weight: 600; padding: 3px 10px;
    background: rgba(139,92,246,.15); border: 1px solid rgba(139,92,246,.3);
    border-radius: 20px; color: #c4b5fd;
}
.music-audio-player { width: 100%; height: 36px; border-radius: 6px; }
.music-meta { font-size: .72rem; color: var(--txt-muted); margin-top: auto; }
.music-actions {
    display: flex; gap: 8px; padding: 10px 16px 14px;
    border-top: 1px solid var(--border-col);
}
.action-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 8px; border: 1px solid var(--border-col);
    background: transparent; cursor: pointer; transition: background .2s, border-color .2s, color .2s;
    color: var(--txt-secondary); text-decoration: none;
}
.edit-btn:hover   { background: rgba(99,102,241,.15); border-color: rgba(99,102,241,.4); color: #a5b4fc; }
.delete-btn:hover { background: rgba(239,68,68,.12);  border-color: rgba(239,68,68,.4);  color: #f87171; }
</style>
}
