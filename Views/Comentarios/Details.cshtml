@model EcommerceApp.Models.ComentariosPorCancion
@{
    ViewData["Title"] = "Comentarios de " + Model.Musica.Nombre;
    ViewData["ActiveMenu"] = "Comentarios";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var artistas = string.Join(", ", Model.Musica.MusicaArtistas.Select(ma => ma.Artista.Nombre));
    var generos = Model.Musica.MusicaGeneros.Select(mg => mg.Genero.Nombre).ToList();
}

<a asp-action="Index" class="cmd-back">← Volver a comentarios</a>

<div class="cmd-head">
    <div class="cmd-cover">
        @if (!string.IsNullOrEmpty(Model.Musica.ImagenUrl))
        {
            <img src="@Model.Musica.ImagenUrl" alt="@Model.Musica.Nombre" />
        }
        else
        {
            <span>♪</span>
        }
    </div>
    <div class="cmd-info">
        <h1 class="cmd-titulo">@Model.Musica.Nombre</h1>
        <div class="cmd-artista">@(string.IsNullOrEmpty(artistas) ? "Sin artista" : artistas)</div>
        <div class="cmd-generos">
            @foreach (var g in generos)
            {
                <span class="cmd-genero">@g</span>
            }
        </div>
        <div class="cmd-total">@Model.Comentarios.Count @(Model.Comentarios.Count == 1 ? "comentario" : "comentarios")</div>
    </div>
</div>

<style>
    .cmd-back { display: inline-block; margin-bottom: 16px; color: var(--txt-secondary); text-decoration: none; font-size: .88rem; }
    .cmd-head { display: flex; gap: 22px; align-items: center; flex-wrap: wrap; background: var(--bg-card); border: 1px solid var(--border-col); border-radius: 16px; padding: 18px; margin-bottom: 22px; }
    .cmd-cover { width: 150px; height: 150px; border-radius: 12px; overflow: hidden; background: rgba(255,255,255,.05); display: flex; align-items: center; justify-content: center; color: var(--txt-muted); font-size: 3rem; flex-shrink: 0; }
    .cmd-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .cmd-info { min-width: 0; display: grid; gap: 6px; }
    .cmd-titulo { margin: 0; font-size: 1.6rem; color: var(--txt-primary); }
    .cmd-artista { color: #22d3ee; font-weight: 600; }
    .cmd-generos { display: flex; flex-wrap: wrap; gap: 6px; }
    .cmd-genero { font-size: .75rem; padding: 3px 10px; border-radius: 999px; background: rgba(124,92,255,.2); color: #c4b5fd; }
    .cmd-total { font-size: .82rem; color: var(--txt-muted); }
    .cmd-lista { display: grid; gap: 10px; }
    .cmd-item { background: var(--bg-card); border: 1px solid var(--border-col); border-radius: 12px; padding: 12px 14px; }
    .cmd-meta { display: flex; justify-content: space-between; gap: 10px; font-size: .82rem; color: var(--txt-secondary); flex-wrap: wrap; }
    .cmd-meta span { color: var(--txt-muted); }
    .cmd-texto { margin-top: 6px; color: var(--txt-primary); white-space: pre-wrap; word-break: break-word; }
    .cmd-vacio { padding: 30px; text-align: center; color: var(--txt-muted); border: 1px dashed var(--border-col); border-radius: 12px; }
</style>

@if (!Model.Comentarios.Any())
{
    <div class="cmd-vacio">Esta canción todavía no tiene comentarios.</div>
}
else
{
    <div class="cmd-lista">
        @foreach (var c in Model.Comentarios)
        {
            <article class="cmd-item">
                <div class="cmd-meta">
                    <b>@(c.User?.UserName ?? "Usuario")</b>
                    <span>@c.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="cmd-texto">@c.Texto</div>
            </article>
        }
    </div>
}
