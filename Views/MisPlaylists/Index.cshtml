@model IEnumerable<EcommerceApp.Models.Playlist>
@{
    ViewData["Title"] = "Playlists";
    ViewData["ActiveMenu"] = "MisPlaylists";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    var publicas = (IEnumerable<EcommerceApp.Models.Playlist>)ViewData["Publicas"]!;
}
@await Html.PartialAsync("_EstilosPlaylists")

<div class="up-page-heading">
    <h1>Playlists</h1>
    <p>Tus playlists privadas y las públicas de la app</p>
</div>

@if (TempData["Success"] != null) { <div class="pl-vacio" style="border-style:solid;color:#4ade80">@TempData["Success"]</div> }

<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px">
    <div class="pl-seccion" style="margin-top:0">Mis playlists privadas</div>
    <a asp-action="Create" class="pl-btn" style="text-decoration:none">+ Nueva playlist</a>
</div>

@if (!Model.Any())
{
    <div class="pl-vacio">Todavía no tienes playlists. Crea una con «+ Nueva playlist».</div>
}
else
{
    <div class="pl-cards">
        @foreach (var p in Model)
        {
            <article class="pl-card">
                <div class="pl-card-titulo">@p.Nombre</div>
                <div class="pl-card-sub">@p.Canciones.Count @(p.Canciones.Count == 1 ? "canción" : "canciones") · Privada</div>
                <div class="pl-card-acciones">
                    <a asp-action="Details" asp-route-id="@p.Id" class="pl-link">▶ Escuchar</a>
                    <a asp-action="Edit" asp-route-id="@p.Id" class="pl-link">Editar</a>
                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" onsubmit="return confirm('¿Eliminar esta playlist?')" style="margin:0">
                        <button type="submit" class="pl-link del">Eliminar</button>
                    </form>
                </div>
            </article>
        }
    </div>
}

<div class="pl-seccion">Playlists públicas</div>
@if (!publicas.Any())
{
    <div class="pl-vacio">Todavía no hay playlists públicas.</div>
}
else
{
    <div class="pl-cards">
        @foreach (var p in publicas)
        {
            <article class="pl-card">
                <div class="pl-card-titulo">@p.Nombre</div>
                <div class="pl-card-sub">@p.Canciones.Count @(p.Canciones.Count == 1 ? "canción" : "canciones") · Pública</div>
                <div class="pl-card-acciones">
                    <a asp-action="Details" asp-route-id="@p.Id" class="pl-link">▶ Escuchar</a>
                </div>
            </article>
        }
    </div>
}
